#!/usr/bin/env python3
"""
bomblabctl - Operator command line for the Bomb Lab contest.

    bomblabctl provision roster.csv     create accounts + per-user bombs
    bomblabctl list                     table of users, state, score
    bomblabctl status                   contest state and timing
    bomblabctl start|freeze|unfreeze|stop|auto
                                        override the contest state
    bomblabctl tick                     apply lock/unlock for current state
    bomblabctl lock|unlock <user>       gate one account
    bomblabctl reset-password <user>    new random password
    bomblabctl export out.csv           final ranking + full event log
    bomblabctl purge [--yes]            remove all contest accounts (after export)
    bomblabctl selftest-user <name>     register an existing account for testing
    bomblabctl hash-password            print a hash for bomblab.ini [admin]

Most commands need root (they create Unix accounts and build bombs).
Account gating uses the account-expiration date, which blocks both password
and key logins: expired => locked, cleared => open.
"""

import argparse
import csv
import datetime
import os
import pwd
import secrets
import string
import subprocess
import sys

# realpath (not abspath) so this resolves correctly when invoked through the
# /usr/local/sbin/bomblabctl symlink that install.sh creates.
_HERE = os.path.dirname(os.path.realpath(__file__))
_ROOT = os.path.dirname(os.path.dirname(_HERE))  # repo root (…/server/bin → …)
sys.path.insert(0, os.path.join(_ROOT, "server"))
sys.path.insert(0, os.path.join(_ROOT, "tools"))

from bomblab import config          # noqa: E402
from bomblab.db import Database      # noqa: E402
from bomblab import scoring          # noqa: E402

PW_ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"  # no 0O1lI
BOMBS_DIR = "/var/lib/bomblab/bombs"


def need_root():
    if os.geteuid() != 0:
        sys.exit("이 명령은 root 권한이 필요합니다 (sudo).")


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, capture_output=True, text=True, **kw)


def gen_password(n=10):
    return "".join(secrets.choice(PW_ALPHABET) for _ in range(n))


def set_password(username, password):
    run(["chpasswd"], input="%s:%s\n" % (username, password))


def set_expired(username, expired):
    # expired: account is locked out. Not expired: open.
    date = "1970-01-02" if expired else "-1"
    run(["usermod", "--expiredate", date, username])


# --------------------------------------------------------------------------
# provision
# --------------------------------------------------------------------------

def build_bomb(username, seed, bomb_id, cfg):
    out = os.path.join(BOMBS_DIR, username)
    os.makedirs(out, exist_ok=True)
    run(["make", "-C", _ROOT, "NOTIFY=1", "SEED=%d" % seed,
         "BOMB_ID=%s" % bomb_id, "OUT=%s" % out,
         "NOTIFY_SOCKET=%s" % cfg.socket, "bomb"])
    return os.path.join(out, "bomb")


def install_home(username, bomb_path):
    home = pwd.getpwnam(username).pw_dir
    dest = os.path.join(home, "bomb")
    os.makedirs(dest, exist_ok=True)
    for src, name in [(bomb_path, "bomb"),
                      (os.path.join(_ROOT, "src", "bomb.c"), "bomb.c"),
                      (os.path.join(_ROOT, "docs", "README.md"), "README.md"),
                      (os.path.join(_ROOT, "docs", "PRIMER.md"), "PRIMER.md")]:
        run(["install", "-m", "0755" if name == "bomb" else "0644",
             src, os.path.join(dest, name)])
    run(["chown", "-R", "%s:%s" % (username, username), dest])
    run(["chmod", "0700", home])


def cmd_provision(args, cfg, db):
    need_root()
    os.makedirs(BOMBS_DIR, exist_ok=True)
    rows = []
    with open(args.roster, newline="", encoding="utf-8") as f:
        for row in csv.reader(f):
            if not row or row[0].strip().startswith("#"):
                continue
            nickname = row[0].strip()
            username = (row[1].strip() if len(row) > 1 and row[1].strip()
                        else None)
            if nickname.lower() in ("nickname", "닉네임"):
                continue
            rows.append((nickname, username))

    existing = {u["username"] for u in db.all_users()}
    n = len(existing)
    creds = []
    for nickname, username in rows:
        if username is None:
            n += 1
            username = "bomb%02d" % n
        if username in existing:
            print("건너뜀 (이미 존재): %s" % username)
            continue

        password = gen_password()
        # Create the account (locked until start).
        run(["useradd", "-m", "-s", "/bin/bash", "-G", "contestants", username])
        set_password(username, password)
        set_expired(username, True)
        uid = pwd.getpwnam(username).pw_uid

        seed = secrets.randbits(63)
        bomb_id = secrets.token_hex(8)
        bomb_path = build_bomb(username, seed, bomb_id, cfg)
        install_home(username, bomb_path)
        db.add_user(username, uid, nickname, seed, bomb_id)
        existing.add(username)
        creds.append((nickname, username, password))
        print("생성: %s (%s)" % (username, nickname))

    if creds:
        write_credentials(cfg, creds)
    print("완료: %d명 신규 생성" % len(creds))


def write_credentials(cfg, creds):
    cpath = os.path.join(os.getcwd(), "credentials.csv")
    with open(cpath, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["nickname", "username", "password", "ssh", "leaderboard"])
        for nick, user, pw in creds:
            w.writerow([nick, user, pw, "ssh %s@%s" % (user, cfg.public_host),
                        "http://%s/" % cfg.public_host])
    os.chmod(cpath, 0o600)

    hpath = os.path.join(os.getcwd(), "cards.html")
    cards = "".join(
        "<div class=card><h2>{nick}</h2>"
        "<table>"
        "<tr><td>서버</td><td><code>ssh {user}@{host}</code></td></tr>"
        "<tr><td>비밀번호</td><td><code>{pw}</code></td></tr>"
        "<tr><td>리더보드</td><td>http://{host}/</td></tr>"
        "</table></div>".format(nick=nick, user=user, pw=pw,
                                host=cfg.public_host)
        for nick, user, pw in creds)
    html = ("<!doctype html><meta charset=utf-8><style>"
            "body{font-family:system-ui;margin:0}"
            ".card{page-break-inside:avoid;border:1px solid #ccc;border-radius:8px;"
            "padding:14px 18px;margin:12px;display:inline-block;width:320px;vertical-align:top}"
            ".card h2{margin:0 0 8px;font-size:16px}"
            "td{padding:3px 8px}code{background:#f2f2f2;padding:1px 5px;border-radius:4px}"
            "</style>" + cards)
    with open(hpath, "w", encoding="utf-8") as f:
        f.write(html)
    os.chmod(hpath, 0o600)
    print("접속 정보: %s , 인쇄용: %s" % (cpath, hpath))


# --------------------------------------------------------------------------
# state overrides + gating
# --------------------------------------------------------------------------

def cmd_state(args, cfg, db):
    mapping = {"start": config.RUNNING, "freeze": config.FROZEN,
               "unfreeze": config.RUNNING, "stop": config.ENDED,
               "auto": "auto"}
    db.set_setting("override", mapping[args.cmd])
    print("상태 override = %s" % mapping[args.cmd])
    cmd_tick(args, cfg, db)


def cmd_tick(args, cfg, db):
    need_root()
    override = db.get_setting("override", "auto")
    state = cfg.state(override)
    open_login = state in (config.RUNNING, config.FROZEN)
    for u in db.all_users():
        set_expired(u["username"], expired=not open_login)
        db.set_locked(u["username"], locked=not open_login)
    if state == config.ENDED and cfg.kick_on_end:
        for u in db.all_users():
            subprocess.run(["pkill", "-KILL", "-u", u["username"]],
                           capture_output=True)
    print("tick: state=%s, login=%s" % (state, "open" if open_login else "locked"))


def cmd_lock(args, cfg, db):
    need_root()
    set_expired(args.user, True)
    db.set_locked(args.user, True)
    print("잠금: %s" % args.user)


def cmd_unlock(args, cfg, db):
    need_root()
    set_expired(args.user, False)
    db.set_locked(args.user, False)
    print("해제: %s" % args.user)


def cmd_reset_password(args, cfg, db):
    need_root()
    if db.user_by_name(args.user) is None:
        sys.exit("없는 사용자: %s" % args.user)
    pw = gen_password()
    set_password(args.user, pw)
    print("%s 새 비밀번호: %s" % (args.user, pw))


# --------------------------------------------------------------------------
# read-only reporting
# --------------------------------------------------------------------------

def _fmt_state(cfg, db):
    override = db.get_setting("override", "auto")
    return cfg.state(override), override


def cmd_status(args, cfg, db):
    state, override = _fmt_state(cfg, db)
    print("대회: %s" % cfg.name)
    print("상태: %s (override=%s)" % (state, override))
    for label, t in [("시작", cfg.start_at), ("프리즈", cfg.freeze_at),
                     ("종료", cfg.end_at)]:
        print("  %s: %s" % (label, t.isoformat() if t else "-"))
    users = db.all_users()
    print("참가자: %d명" % len(users))


def cmd_list(args, cfg, db):
    _, override = _fmt_state(cfg, db)
    cut = scoring.cutoff_for(cfg, override, public=False)
    rows = scoring.score_rows(cfg, db.all_users(), db.all_events(), cut)
    locked = {u["username"]: u["locked"] for u in db.all_users()}
    print("%-4s %-10s %-14s %6s %5s %6s %s" %
          ("#", "user", "nickname", "score", "boom", "login", "phases"))
    for r in rows:
        phs = "".join(str(p) for p in range(1, 7) if p in r["phases"])
        if 7 in r["phases"]:
            phs += "★"
        print("%-4s %-10s %-14s %6s %5s %6s %s" %
              (r["rank"], r["username"], r["nickname"], r["score"],
               r["explosions"],
               "잠김" if locked.get(r["username"]) else "열림", phs or "-"))


def cmd_export(args, cfg, db):
    _, override = _fmt_state(cfg, db)
    cut = scoring.cutoff_for(cfg, override, public=False)
    rows = scoring.score_rows(cfg, db.all_users(), db.all_events(), cut)
    with open(args.out, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["rank", "username", "nickname", "score", "explosions",
                    "p1", "p2", "p3", "p4", "p5", "p6", "secret"])
        for r in rows:
            w.writerow([r["rank"], r["username"], r["nickname"], r["score"],
                        r["explosions"]]
                       + ["Y" if p in r["phases"] else "" for p in range(1, 8)])
    epath = args.out + ".events.csv"
    with open(epath, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["time", "username", "nickname", "phase", "kind",
                    "input", "late"])
        for e in db.all_events():
            w.writerow([datetime.datetime.fromtimestamp(e["created_at"]).isoformat(),
                        e["username"], e["nickname"], e["phase"], e["kind"],
                        e["input"] or "", e["late"]])
    print("순위: %s , 이벤트: %s" % (args.out, epath))


def cmd_purge(args, cfg, db):
    need_root()
    if not args.yes:
        sys.exit("계정과 홈 디렉터리를 삭제합니다. 확인하려면 --yes 를 붙이세요. "
                 "(먼저 export 를 실행했는지 확인)")
    for u in db.all_users():
        subprocess.run(["pkill", "-KILL", "-u", u["username"]],
                       capture_output=True)
        subprocess.run(["userdel", "-r", u["username"]], capture_output=True)
        db.delete_user(u["username"])
    print("모든 대회 계정 삭제 완료")


def cmd_selftest_user(args, cfg, db):
    # Register an existing local account (e.g. the operator's) for testing.
    entry = pwd.getpwnam(args.user)
    seed = secrets.randbits(63)
    bomb_id = secrets.token_hex(8)
    if db.user_by_name(args.user) is None:
        db.add_user(args.user, entry.pw_uid, args.user, seed, bomb_id)
    else:
        db.update_seed(args.user, seed, bomb_id)
    print("테스트 사용자 등록: %s uid=%d seed=%d bomb_id=%s"
          % (args.user, entry.pw_uid, seed, bomb_id))


def cmd_hash_password(args, cfg, db):
    import getpass
    pw = getpass.getpass("admin password: ")
    print(config.hash_password(pw))


# --------------------------------------------------------------------------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="bomblabctl")
    ap.add_argument("--config", help="path to bomblab.ini")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("provision").add_argument("roster")
    for c in ("start", "freeze", "unfreeze", "stop", "auto", "tick",
              "status", "list"):
        sub.add_parser(c)
    for c in ("lock", "unlock", "reset-password", "selftest-user"):
        sub.add_parser(c).add_argument("user")
    sub.add_parser("export").add_argument("out")
    p = sub.add_parser("purge"); p.add_argument("--yes", action="store_true")
    sub.add_parser("hash-password")

    args = ap.parse_args(argv)

    if args.config:
        os.environ["BOMBLAB_CONFIG"] = args.config
    cfg = config.Config(args.config)

    # hash-password needs no DB.
    if args.cmd == "hash-password":
        return cmd_hash_password(args, cfg, None)

    db = Database(cfg.db)
    dispatch = {
        "provision": cmd_provision,
        "start": cmd_state, "freeze": cmd_state, "unfreeze": cmd_state,
        "stop": cmd_state, "auto": cmd_state,
        "tick": cmd_tick, "status": cmd_status, "list": cmd_list,
        "lock": cmd_lock, "unlock": cmd_unlock,
        "reset-password": cmd_reset_password, "export": cmd_export,
        "purge": cmd_purge, "selftest-user": cmd_selftest_user,
    }
    return dispatch[args.cmd](args, cfg, db)


if __name__ == "__main__":
    sys.exit(main() or 0)
