#!/usr/bin/env python3
"""
bomblab - 연습 서버 학생용 명령.

    bomblab                       내 폭탄과 진도
    bomblab notes <폭탄> [단계]   해제한 단계의 해설
    bomblab hint <폭탄> <단계>    다음 힌트 열기 (1 → 2 → 3)
    bomblab new practice          연습 폭탄 새로 받기
    bomblab new d3                드릴 D3 새로 받기

<폭탄>은 practice, d0 ~ d9 중 하나. 과제형 폭탄(~/bomb)은 해설·힌트·재발급이 없다.

Self-contained (standard library only) and installed to /usr/local/bin: the
server's own code under /opt/bomblab is not readable by students. It talks to
the record daemon, which identifies the student by uid (SO_PEERCRED).
"""

import json
import os
import socket
import sys
import time

SOCKET = os.environ.get("BOMBLAB_SOCKET", "/run/bomblab/report.sock")
TRACK_NAME = {"assign": "과제형", "practice": "연습", "drill": "드릴"}


class ServerError(Exception):
    pass


def request(line):
    """Send one request; return (status_line, body or None)."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(10)
    try:
        s.connect(SOCKET)
    except OSError:
        raise ServerError("기록 서버에 연결할 수 없습니다. 잠시 후 다시 시도하세요.")
    s.sendall(line.encode() + b"\n")
    data = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        data += chunk
    s.close()
    head, _, rest = data.partition(b"\n")
    head = head.decode("utf-8", "replace")
    if head.startswith("OK ") and head[3:].isdigit():
        n = int(head[3:])
        return "OK", rest[:n].decode("utf-8", "replace")
    return head, None


def status():
    head, _ = request("STATUS")
    if not head.startswith("OK "):
        raise ServerError(_why(head))
    return json.loads(head[3:])


def _why(head):
    msg = head.split(" ", 1)[1] if " " in head else head
    return {
        "unknown user": "이 계정은 연습 서버에 등록되어 있지 않습니다.",
        "defuse this phase first": "해설은 그 단계를 해제한 뒤에 열립니다.",
        "write-ups are not released for the scored bomb":
            "과제형 폭탄(~/bomb)의 해설은 공개되지 않습니다.",
        "no hints for the scored bomb": "과제형 폭탄(~/bomb)에는 힌트가 없습니다.",
        "the scored bomb is not reissued": "과제형 폭탄은 다시 받을 수 없습니다.",
        "a request is already being built": "이미 만드는 중인 폭탄이 있습니다. 잠시 기다리세요.",
        "too many requests this hour": "한 시간에 받을 수 있는 횟수를 넘었습니다.",
        "the practice server is closed": "지금은 연습 서버 운영 기간이 아닙니다.",
        "no such bomb": "그런 폭탄이 없습니다. `bomblab`으로 목록을 확인하세요.",
    }.get(msg, msg)


def find(st, label):
    for b in st["bombs"]:
        if b["label"] == label.lower():
            return b
    raise ServerError("'%s' 폭탄이 없습니다. practice, d0 ~ d9 중에서 고르세요." % label)


def _stage_name(b, s):
    return "숨은 단계" if s > b["num_phases"] else "%d단계" % s


def cmd_status(args):
    st = status()
    print("%s 님의 폭탄%s" % (st["user"], "" if st["state"] == "open"
                              else "  (지금은 운영 기간이 아님)"))
    print()
    for b in st["bombs"]:
        n = b["num_phases"]
        marks = "".join("●" if s in b["defused"] else "·"
                        for s in range(1, n + 1))
        if b["phases"] > n:
            marks += " ★" if b["phases"] in b["defused"] else " ☆"
        extra = ""
        if b["track"] != "assign" and b["defused"]:
            extra = "  해설: bomblab notes %s" % b["label"]
        print("  %-9s %-14s %s  폭발 %d%s" % (b["label"], b["dir"], marks,
                                            b["explosions"], extra))
    for r in st.get("requests", []):
        print("\n  만드는 중: %s (요청 #%d)" % (r["kind"], r["id"]))
    print("\n  ● 해제  · 아직  ★ 숨은 단계")
    print("  해설·힌트는 연습(practice)과 드릴(d0~d9)에만 있습니다.")


def cmd_notes(args):
    if not args:
        sys.exit("사용법: bomblab notes <practice|d0..d9> [단계]")
    st = status()
    b = find(st, args[0])
    if b["track"] == "assign":
        raise ServerError(_why("x write-ups are not released for the scored bomb"))
    stages = [int(args[1])] if len(args) > 1 else b["notes"]
    if not stages:
        print("%s: 아직 해제한 단계가 없습니다. 해설은 해제한 단계부터 열립니다."
              % b["label"])
        return
    for s in stages:
        head, body = request("NOTES %s %d" % (b["bomb_id"], s))
        if head != "OK":
            print("[%s %s] %s" % (b["label"], _stage_name(b, s), _why(head)))
            continue
        print(body)
        print("-" * 72)


def cmd_hint(args):
    if len(args) != 2 or not args[1].isdigit():
        sys.exit("사용법: bomblab hint <practice|d0..d9> <단계>")
    st = status()
    b = find(st, args[0])
    s = int(args[1])
    opened = b["hints"].get(str(s), [])
    k = min(len(opened) + 1, 3)
    for i in range(1, k + 1):
        head, body = request("HINT %s %d %d" % (b["bomb_id"], s, i))
        if head != "OK":
            raise ServerError(_why(head))
        print(body.strip())
        print()
    if k == 3 and len(opened) >= 3:
        print("(힌트 3개를 모두 열었습니다)")
    elif k < 3:
        print("(다음 힌트: bomblab hint %s %d)" % (b["label"], s))


def cmd_new(args):
    if len(args) != 1:
        sys.exit("사용법: bomblab new <practice|d0..d9>")
    head, _ = request("NEW %s" % args[0])
    if not head.startswith("OK "):
        raise ServerError(_why(head))
    req = head[3:]
    print("새 폭탄을 만드는 중입니다", end="", flush=True)
    for _ in range(180):
        time.sleep(1)
        head, _ = request("REQ %s" % req)
        if head == "PENDING":
            print(".", end="", flush=True)
            continue
        print()
        if head.startswith("DONE "):
            print("완료: %s 에 새 폭탄이 설치되었습니다." % head[5:])
            print("이전 폭탄은 더 이상 기록되지 않습니다. 답 파일이 있다면 새로 써야 합니다.")
            return
        raise ServerError("만들지 못했습니다: %s" % head.split(" ", 1)[-1])
    print()
    raise ServerError("시간이 오래 걸립니다. 잠시 뒤 `bomblab`으로 확인하세요.")


COMMANDS = {"status": cmd_status, "notes": cmd_notes, "hint": cmd_hint,
            "new": cmd_new}


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help", "help"):
        print(__doc__.split("\n\n")[1])
        return 0
    cmd = argv[1] if len(argv) > 1 else "status"
    fn = COMMANDS.get(cmd)
    if fn is None:
        print(__doc__.split("\n\n")[1])
        return 2
    try:
        fn(argv[2:])
    except ServerError as e:
        print("bomblab: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
