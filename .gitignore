cards.html
# 실제 운영 설정(관리자 해시·시각 등). 예시 파일(.example)만 커밋
bomblab.ini
*.db
*.db-wal
*.db-shm
# 툴체인 이미지 백업 (docker save)
*.tar.gz

# ---- 로컬 개발 환경 ----
.claude/settings.local.json
__pycache__/
*.pyc

